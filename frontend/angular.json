{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "supermarket": {
      "projectType": "application", "root": "", "sourceRoot": "src",
      "schematics": {
        "@schematics/angular:component": { "style": "scss" }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts", "index": "src/index.html", "tsConfig": "tsconfig.app.json", "outputPath": "dist",
            "assets": [{ "glob": "**/*", "input": "src/assets/img", "output": "assets/img" }],
            "styles": ["src/styles.scss"],
            "inlineStyleLanguage": "scss"
          },
          "configurations": {
            "production": { "outputHashing": "all", "budgets": [{ "type": "initial", "maximumWarning": "700kB", "maximumError": "1MB" }] },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": { "builder": "@angular/build:dev-server", "options": { "buildTarget": "supermarket:build:development" } },
        "test": { "builder": "@angular/build:unit-test", "options": { "tsConfig": "tsconfig.spec.json", "runner": "vitest", "buildTarget": "supermarket:build:development" } }
      }
    }
  }
}
