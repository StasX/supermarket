{
  "compilerOptions": {
    "target": "ES2022", "module": "preserve", "moduleResolution": "bundler", "lib": ["ES2022", "DOM"],
    "strict": true, "noImplicitOverride": true, "noPropertyAccessFromIndexSignature": true, "skipLibCheck": true,
    "experimentalDecorators": true, "isolatedModules": true, "importHelpers": true,
    "types": ["node"]
  },
  "angularCompilerOptions": { "strictTemplates": true, "strictInjectionParameters": true },
  "include": ["playwright.config.ts", "e2e/**/*.ts"]
}
