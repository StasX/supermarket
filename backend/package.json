{
  "name": "project4-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node ./dist/main.js",
    "start:prod": "node ./dist/main.js",
    "test": "npm run build && npm run build:tests && node --experimental-vm-modules node_modules/jest/bin/jest.js --config dist/jest.config.js --runInBand",
    "test:backend": "npm test",
    "test:integration": "npm run build && npm run build:tests && node --test --test-concurrency=1 tests-dist/integration.test.js",
    "build:tests": "tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/serve-static": "^12.1.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "mongoose": "^9.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.5.0",
    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "jest": {
      "glob": "14.0.6",
      "minimatch": "11.0.8"
    }
  },
  "engines": {
    "node": "^26.13.1"
  }
}
