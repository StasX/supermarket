{
    "name": "project4-api",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "start": "npm run build && node ./dist/main.js",
        "start:prod": "node ./dist/main.js",
        "test": "npm run build && npm run build:tests && jest --config dist/jest.config.js --runInBand",
        "test:backend": "npm test",
        "test:integration": "npm run build && npm run build:tests && node --test --test-concurrency=1 tests-dist/integration.test.js",
        "build:tests": "tsc -p tsconfig.tests.json"
    },
    "dependencies": {
        "@nestjs/common": "^11.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/platform-express": "^11.0.0",
        "@nestjs/serve-static": "^5.0.0",
        "bcryptjs": "^3.0.0",
        "cookie-parser": "^1.4.7",
        "express": "^5.1.0",
        "jsonwebtoken": "^9.0.0",
        "mongoose": "^9.12.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.0"
    },
    "devDependencies": {
        "@nestjs/testing": "^11.0.0",
        "@types/node": "^22.0.0",
        "jest": "^30.5.2",
        "supertest": "^7.0.0",
        "typescript": "^5.9.0"
    }
}
